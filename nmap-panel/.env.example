# --- Настройка подключения фронтенда к API ---
# По умолчанию фронт ходит на относительный путь /api (тот же origin, что отдал
# страницу). Менять нужно только для нестандартных схем размещения.

# Базовый URL API, вшиваемый в сборку (vite build). Пусто = /api (рекомендуется).
# Пример для доступа к отдельному бэкенду по IP:
# VITE_API_BASE=http://192.168.1.10:5000/api
VITE_API_BASE=

# Куда dev-сервер (pnpm dev) проксирует /api. Только для локальной разработки.
VITE_API_PROXY=http://127.0.0.1:5000
