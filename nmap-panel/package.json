{
  "name": "machine-party-kit",
  "version": "1.0.0",
  "description": "Industrial neon UI kit for React",
  "type": "module",
  "main": "dist/machine-party-kit.cjs.js",
  "module": "dist/machine-party-kit.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/machine-party-kit.es.js",
      "require": "./dist/machine-party-kit.cjs.js",
